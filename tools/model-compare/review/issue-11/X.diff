+proptest! {
+    #[test]
+    fn malformed_input_never_panics(bytes in proptest::collection::vec(any::<u8>(), 0..512), flips in proptest::collection::vec((any::<usize>(), any::<u8>()), 0..8)) {
+        // Catches: panics (slice bounds, overflow) on arbitrary or bit-flipped archives.
+        let _ = ZipReader::open(bytes).map(|r| r.read_all().map(|p| p.len()));
+        let mut zip = one_entry("a.xml", 8, &deflate(b"<a>hello hello hello</a>"), 24);
+        for (at, value) in flips {
+            let len = zip.len();
+            zip[at % len] = value;
+        }
+        let _ = ZipReader::open(zip).map(|r| r.read_all().map(|p| p.len()));
+    }
+}
