{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nitro-xml.dev/edits/schema.json",
  "title": "Nitro XML editor op-script",
  "description": "Format-neutral editor command scripts for gate (b)/(c). One vocabulary drives the TS oracle and the Rust editor (#63+).",
