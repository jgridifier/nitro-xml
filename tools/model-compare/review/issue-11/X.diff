@@ -0,0 +1,47 @@
+// SPDX-License-Identifier: MIT
+//! Dumps every part of a package through the bounded zip reader as JSON, for the #11
+//! differential gate against upstream `readZipParts`.
+//!
+//! Usage: `zip_dump <file>`. Prints `{"parts":[{"name","size","sha256"}, ...]}` sorted by name, or
+//! `{"error":"<kind>"}` and exits with status 2.
+
+use nitro_xml_opc::zip::ZipReader;
+use serde_json::json;
+use sha2::{Digest, Sha256};
+use std::fmt::Write as _;
+use std::process::ExitCode;
+
+fn fail(kind: &str) -> ExitCode {
+    println!("{}", json!({ "error": kind }));
+    ExitCode::from(2)
+}
+
+fn main() -> ExitCode {
+    let Some(path) = std::env::args_os().nth(1) else {
+        return fail("usage");
+    };
+    let Ok(bytes) = std::fs::read(path) else {
+        return fail("io");
+    };
+    let reader = match ZipReader::open(bytes) {
+        Ok(reader) => reader,
+        Err(e) => return fail(e.kind()),
+    };
+    let mut parts = match reader.read_all() {
+        Ok(parts) => parts,
+        Err(e) => return fail(e.kind()),
+    };
+    parts.sort_by(|a, b| a.0.as_bytes().cmp(b.0.as_bytes()));
+    let parts: Vec<_> = parts
+        .iter()
+        .map(|(name, data)| {
+            let mut hex = String::with_capacity(64);
+            for byte in Sha256::digest(data) {
+                let _ = write!(hex, "{byte:02x}");
+            }
+            json!({ "name": name, "size": data.len(), "sha256": hex })
+        })
+        .collect();
+    println!("{}", json!({ "parts": parts }));
+    ExitCode::SUCCESS
+}
