    "format": {
      "type": "string",
      "enum": [
        "xlsx",
        "docx",
        "pptx"
      ]
    },
    "fixture": {
      "type": "string",
      "minLength": 1,
      "description": "fixtures/manifest.json id"
    },
    "description": {
      "type": "string"
    },
    "modelOnly": {
      "type": "boolean",
      "description": "Model/undo parity only \u2014 skip package save (upstream save broken or Depends on #80 writer)."
    },
    "ops": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/op"
      }
    }
  },
