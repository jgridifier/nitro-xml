+// SPDX-License-Identifier: Apache-2.0
+// Ported from ChristopherVR/ooxml@e66aaec src/core/xlsx/read/package.ts; changes listed in PROVENANCE.md.
+//! Bounded raw-deflate inflation of one entry.
+
+use flate2::{Decompress, FlushDecompress, Status};
+
+/// Why [`inflate_bounded`] stopped.
+#[derive(Debug, PartialEq, Eq)]
+pub(super) enum InflateError {
+    /// More than `cap` bytes came out.
+    PastCap,
+    /// The deflate stream is corrupt.
+    Corrupt,
+}
+
+/// Deflate never expands better than about 1032:1, so a buffer larger than this is never needed
+/// for `compressed` input bytes; it keeps a lying header from forcing a huge allocation up front.
+fn max_inflated(compressed: usize) -> usize {
+    compressed.saturating_mul(1032).saturating_add(1024)
+}
+
+/// Inflates a raw deflate stream, failing as soon as more than `cap` bytes are produced, before
+/// the rest of the stream is inflated. A stream that ends early (truncated input) yields the bytes
+/// produced so far; the caller compares them with the declared size, like JSZip.
+pub(super) fn inflate_bounded(input: &[u8], cap: usize) -> Result<Vec<u8>, InflateError> {
+    // One byte of headroom over the cap is how an overshoot is detected.
+    let limit = cap.saturating_add(1);
+    let mut out: Vec<u8> = Vec::with_capacity(limit.min(max_inflated(input.len())).min(1 << 16));
+    let mut inflater = Decompress::new(false);
+    loop {
+        if out.len() == out.capacity() {
+            let grow = out.capacity().max(4096).min(limit - out.len());
+            out.reserve_exact(grow);
+        }
+        let consumed = usize::try_from(inflater.total_in()).unwrap_or(input.len());
+        let rest = input.get(consumed..).unwrap_or(&[]);
+        let (before_in, before_out) = (inflater.total_in(), inflater.total_out());
+        let status = inflater
+            .decompress_vec(rest, &mut out, FlushDecompress::Finish)
+            .map_err(|_| InflateError::Corrupt)?;
+        if out.len() > cap {
+            return Err(InflateError::PastCap);
+        }
+        if status == Status::StreamEnd {
+            return Ok(out);
+        }
+        let progressed = inflater.total_in() != before_in || inflater.total_out() != before_out;
+        if !progressed && out.len() < out.capacity() {
+            // No output space was missing, so the input ran out before the final block.
+            return Ok(out);
+        }
+    }
+}
