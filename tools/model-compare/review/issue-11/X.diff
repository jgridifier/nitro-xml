+// SPDX-License-Identifier: MIT
+//! Typed errors of the bounded zip reader.
+
+use std::fmt;
+
+/// Why a package could not be opened or a part could not be read.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum ZipError {
+    /// The compressed input is larger than [`ZipLimits::max_input_bytes`](super::ZipLimits).
+    InputTooLarge,
+    /// The bytes are not a readable zip archive (no end of central directory, truncated records,
+    /// entries pointing outside the input, ...). The string is the underlying cause.
+    Malformed(String),
+    /// An entry is encrypted; encrypted packages are not supported.
+    Encrypted { name: String },
+    /// An entry uses a compression method other than stored (0) or deflate (8).
+    UnsupportedCompression { name: String, method: u16 },
+    /// The archive has more non-directory entries than [`ZipLimits::max_parts`](super::ZipLimits).
+    TooManyParts,
+    /// An entry declares an uncompressed size above [`ZipLimits::max_part_bytes`](super::ZipLimits).
+    PartTooLarge { name: String },
+    /// The declared or inflated total exceeds [`ZipLimits::max_total_bytes`](super::ZipLimits).
+    TotalTooLarge,
+    /// An entry inflated past the uncompressed size its headers declare (a lying zip bomb).
+    InflatesPastDeclared { name: String },
+    /// An entry inflated to fewer bytes than its headers declare.
+    SizeMismatch { name: String },
+    /// An entry's deflate stream is corrupt.
+    CorruptDeflate { name: String },
+}
+
+impl ZipError {
+    /// A short stable identifier of the error kind (no part names or causes).
+    pub fn kind(&self) -> &'static str {
+        match self {
+            Self::InputTooLarge => "input-too-large",
+            Self::Malformed(_) => "malformed",
+            Self::Encrypted { .. } => "encrypted",
+            Self::UnsupportedCompression { .. } => "unsupported-compression",
+            Self::TooManyParts => "too-many-parts",
+            Self::PartTooLarge { .. } => "part-too-large",
+            Self::TotalTooLarge => "total-too-large",
+            Self::InflatesPastDeclared { .. } => "inflates-past-declared",
+            Self::SizeMismatch { .. } => "size-mismatch",
+            Self::CorruptDeflate { .. } => "corrupt-deflate",
+        }
+    }
+}
+
+impl fmt::Display for ZipError {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::InputTooLarge => f.write_str("package exceeds the compressed input limit"),
+            Self::Malformed(cause) => write!(f, "not a valid zip package: {cause}"),
+            Self::Encrypted { name } => write!(f, "part {name} is encrypted"),
+            Self::UnsupportedCompression { name, method } => {
+                write!(
+                    f,
+                    "part {name} uses unsupported compression method {method}"
+                )
+            }
+            Self::TooManyParts => f.write_str("package exceeds the part limit"),
+            Self::PartTooLarge { name } => {
+                write!(f, "part {name} exceeds the uncompressed part size limit")
+            }
+            Self::TotalTooLarge => f.write_str("package exceeds the uncompressed content limit"),
+            Self::InflatesPastDeclared { name } => {
+                write!(f, "part {name} inflates past its declared size")
+            }
+            Self::SizeMismatch { name } => {
+                write!(f, "part {name} inflates to less than its declared size")
+            }
+            Self::CorruptDeflate { name } => write!(f, "part {name} has a corrupt deflate stream"),
+        }
+    }
+}
+
+impl std::error::Error for ZipError {}
