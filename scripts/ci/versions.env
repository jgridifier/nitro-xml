# Pinned tool versions for CI scripts. Upgrading = a script PR (no workflow change).
DOTNET_SDK_VERSION=8.0.414
OPENXML_SDK_VERSION=3.3.0
LIBREOFFICE_APT_PACKAGE=libreoffice-core-nogui
WASM_PACK_VERSION=0.15.0
CARGO_DENY_VERSION=0.20.2
NODE_VERSION=22
NITRO_TOOLS_DIR=${HOME}/.nitro-tools

# Scoreboard parse race (#39/#40). Keep in sync with perf/scoreboard/races/parse/defaults.json.
SCOREBOARD_SEED_DEFAULT=20261011
SCOREBOARD_WARMUP_DEFAULT=2
SCOREBOARD_RUNS_DEFAULT=11
SCOREBOARD_CHROME_PATH=/usr/bin/google-chrome
