+++ b/rs/crates/nitro-xml-opc/src/zip/mod.rs
@@ -0,0 +1,335 @@
+// SPDX-License-Identifier: Apache-2.0
+// Ported from ChristopherVR/ooxml@e66aaec src/core/xlsx/read/package.ts; changes listed in PROVENANCE.md.
+//! Bounded zip reader.
+//!
+//! Upstream reads packages through JSZip in `readZipParts` (`src/core/xlsx/read/package.ts`),
+//! whose behaviour is the parity reference: the size and part-count limits, directory entries
+//! skipped, a leading `/` stripped from names, case-insensitive lookup like
+//! `SourceIndex.lowerNames`, and inflation that stops as soon as an entry produces more bytes than
+//! its headers declare.
+//!
+//! Unlike upstream, [`ZipReader::open`] only reads the central directory and local headers; each
+//! part is inflated when it is asked for ([`ZipReader::read`]). Stored parts are borrowed from the
+//! input without a copy.
+
+mod error;
+mod inflate;
+
+use std::borrow::Cow;
+use std::collections::HashMap;
+use std::io::Cursor;
+
+pub use error::ZipError;
+use inflate::{inflate_bounded, InflateError};
+
+/// Largest accepted package (compressed).
+pub const MAX_INPUT_BYTES: u64 = 50 * 1024 * 1024;
+/// Largest number of zip entries.
+pub const MAX_PARTS: usize = 10_000;
+/// Largest total uncompressed size, guarding against zip bombs.
+pub const MAX_UNCOMPRESSED_BYTES: u64 = 300 * 1024 * 1024;
+/// Largest uncompressed size of a single part.
+pub const MAX_PART_BYTES: u64 = 200 * 1024 * 1024;
+
+/// Size limits applied while unzipping; [`Default`] uses the exported constants.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct ZipLimits {
+    /// Largest accepted package (compressed).
+    pub max_input_bytes: u64,
+    /// Largest number of (non-directory) zip entries.
+    pub max_parts: usize,
+    /// Largest inflated size of one part.
+    pub max_part_bytes: u64,
+    /// Largest total inflated size of all parts.
+    pub max_total_bytes: u64,
+}
+
+impl Default for ZipLimits {
+    fn default() -> Self {
+        Self {
+            max_input_bytes: MAX_INPUT_BYTES,
+            max_parts: MAX_PARTS,
+            max_part_bytes: MAX_PART_BYTES,
+            max_total_bytes: MAX_UNCOMPRESSED_BYTES,
+        }
+    }
+}
+
+/// A part name and its inflated bytes, as returned by [`ZipReader::read_all`].
+pub type Part<'a> = (&'a str, Cow<'a, [u8]>);
+
+const METHOD_STORED: u16 = 0;
+const METHOD_DEFLATED: u16 = 8;
+
+/// One part of the package: where its bytes are and what its headers declare.
+#[derive(Debug, Clone)]
+struct Entry {
+    /// Part name with any leading `/` stripped.
+    name: String,
+    /// Declared uncompressed size (central directory, zip64-aware).
+    declared: u64,
+    method: u16,
+    /// Byte range of the compressed data within the input.
+    start: usize,
+    end: usize,
+}
+
+/// An opened zip package. Holds the input bytes and an index of its parts; nothing is inflated
+/// until a part is read.
+#[derive(Debug)]
+pub struct ZipReader<B> {
+    data: B,
+    /// Parts in archive order (first occurrence of each name).
+    parts: Vec<Entry>,
+    by_name: HashMap<String, usize>,
+    /// Lower-cased name to index; the last part with a given lower-cased name wins, like
+    /// `SourceIndex.lowerNames`.
+    lower_names: HashMap<String, usize>,
+    limits: ZipLimits,
+}
+
+impl<B: AsRef<[u8]>> ZipReader<B> {
+    /// Opens a package with the default [`ZipLimits`].
+    pub fn open(data: B) -> Result<Self, ZipError> {
+        Self::open_with_limits(data, ZipLimits::default())
+    }
+
+    /// Opens a package, reading its central directory and checking the declared sizes against
+    /// `limits`. No part is inflated.
+    pub fn open_with_limits(data: B, limits: ZipLimits) -> Result<Self, ZipError> {
+        let bytes = data.as_ref();
+        if bytes.len() as u64 > limits.max_input_bytes {
+            return Err(ZipError::InputTooLarge);
+        }
+        let entries = scan_entries(bytes)?;
+        if entries.len() > limits.max_parts {
+            return Err(ZipError::TooManyParts);
+        }
+        let mut declared: u64 = 0;
+        for entry in &entries {
+            if entry.entry.declared > limits.max_part_bytes {
+                return Err(ZipError::PartTooLarge {
+                    name: entry.raw_name.clone(),
+                });
+            }
+            declared = declared.saturating_add(entry.entry.declared);
+        }
+        if declared > limits.max_total_bytes {
+            return Err(ZipError::TotalTooLarge);
+        }
+
+        // Upstream stores parts in a Map keyed by the stripped name, so a later entry replaces an
+        // earlier one with the same stripped name but keeps its position.
+        let mut parts: Vec<Entry> = Vec::with_capacity(entries.len());
+        let mut by_name: HashMap<String, usize> = HashMap::with_capacity(entries.len());
+        for scanned in entries {
+            let entry = scanned.entry;
+            match by_name.get(&entry.name) {
+                Some(&i) => parts[i] = entry,
+                None => {
+                    by_name.insert(entry.name.clone(), parts.len());
+                    parts.push(entry);
+                }
+            }
+        }
+        let mut lower_names = HashMap::with_capacity(parts.len());
+        for (i, part) in parts.iter().enumerate() {
+            lower_names.insert(part.name.to_lowercase(), i);
+        }
+        Ok(Self {
+            data,
+            parts,
+            by_name,
+            lower_names,
+            limits,
+        })
+    }
+
+    /// Number of parts (directory entries excluded).
+    pub fn len(&self) -> usize {
+        self.parts.len()
+    }
+
+    /// Whether the package has no parts.
+    pub fn is_empty(&self) -> bool {
+        self.parts.is_empty()
+    }
+
+    /// Part names in archive order, without a leading `/`.
+    pub fn names(&self) -> impl Iterator<Item = &str> {
+        self.parts.iter().map(|p| p.name.as_str())
+    }
+
+    /// The stored name of a part; OPC part names compare case-insensitively.
+    pub fn actual(&self, name: &str) -> Option<&str> {
+        self.index_of(name).map(|i| self.parts[i].name.as_str())
+    }
+
+    /// Whether a part exists (case-insensitive).
+    pub fn contains(&self, name: &str) -> bool {
+        self.index_of(name).is_some()
+    }
+
+    /// The uncompressed size a part declares, if the part exists.
+    pub fn declared_size(&self, name: &str) -> Option<u64> {
+        self.index_of(name).map(|i| self.parts[i].declared)
+    }
+
+    /// Inflates one part, or returns `Ok(None)` when no part has that name (case-insensitive).
+    /// Stored parts are borrowed from the input. Inflation stops as soon as the part produces
+    /// more bytes than it declares, so a lying entry cannot exhaust memory.
+    pub fn read(&self, name: &str) -> Result<Option<Cow<'_, [u8]>>, ZipError> {
+        match self.index_of(name) {
+            Some(i) => self.read_index(i).map(Some),
+            None => Ok(None),
+        }
+    }
+
+    /// Inflates every part in archive order, also enforcing the total-size limit on the bytes
+    /// actually produced.
+    pub fn read_all(&self) -> Result<Vec<Part<'_>>, ZipError> {
+        let mut out = Vec::with_capacity(self.parts.len());
+        let mut total: u64 = 0;
+        for (i, part) in self.parts.iter().enumerate() {
+            let bytes = self.read_index(i)?;
+            total = total.saturating_add(bytes.len() as u64);
+            if total > self.limits.max_total_bytes {
+                return Err(ZipError::TotalTooLarge);
+            }
+            out.push((part.name.as_str(), bytes));
+        }
+        Ok(out)
+    }
+
+    fn index_of(&self, name: &str) -> Option<usize> {
+        self.by_name
+            .get(name)
+            .or_else(|| self.lower_names.get(&name.to_lowercase()))
+            .copied()
+    }
+
+    fn read_index(&self, i: usize) -> Result<Cow<'_, [u8]>, ZipError> {
+        let part = &self.parts[i];
+        let raw = &self.data.as_ref()[part.start..part.end];
+        // The declared size already passed the per-part limit and the declared total passed the
+        // package limit, so capping each part at its declared size bounds both.
+        let cap = part.declared.min(self.limits.max_part_bytes);
+        let bytes = match part.method {
+            METHOD_STORED => Cow::Borrowed(raw),
+            _ => {
+                let cap = usize::try_from(cap).unwrap_or(usize::MAX);
+                Cow::Owned(inflate_bounded(raw, cap).map_err(|e| match e {
+                    InflateError::PastCap => ZipError::InflatesPastDeclared {
+                        name: part.name.clone(),
+                    },
+                    InflateError::Corrupt => ZipError::CorruptDeflate {
+                        name: part.name.clone(),
+                    },
+                })?)
+            }
+        };
+        let produced = bytes.len() as u64;
+        if produced > part.declared {
+            return Err(ZipError::InflatesPastDeclared {
+                name: part.name.clone(),
+            });
+        }
+        if produced < part.declared {
+            return Err(ZipError::SizeMismatch {
+                name: part.name.clone(),
+            });
+        }
+        Ok(bytes)
+    }
+}
+
+/// A non-directory entry as found in the central directory.
+struct Scanned {
+    /// Name as stored (before the leading `/` is stripped), for error messages.
+    raw_name: String,
+    entry: Entry,
+}
+
+/// Reads the central directory and every local header (to find where data starts), skipping
+/// directories. Entries repeating an earlier raw name replace it, like JSZip's `files` object.
+fn scan_entries(bytes: &[u8]) -> Result<Vec<Scanned>, ZipError> {
+    let malformed = |e: zip::result::ZipError| ZipError::Malformed(e.to_string());
+    let mut archive = zip::ZipArchive::new(Cursor::new(bytes)).map_err(malformed)?;
+    let mut entries: Vec<Scanned> = Vec::with_capacity(archive.len());
+    let mut by_raw: HashMap<String, usize> = HashMap::with_capacity(archive.len());
+    for index in 0..archive.len() {
+        let file = archive.by_index_raw(index).map_err(malformed)?;
+        let raw_name = String::from_utf8_lossy(file.name_raw()).into_owned();
+        if file.encrypted() {
+            return Err(ZipError::Encrypted { name: raw_name });
+        }
+        let method = compression_method(bytes, file.central_header_start())
+            .ok_or_else(|| ZipError::Malformed("central directory record truncated".into()))?;
+        if method != METHOD_STORED && method != METHOD_DEFLATED {
+            return Err(ZipError::UnsupportedCompression {
+                name: raw_name,
+                method,
+            });
+        }
+        let start = file
+            .data_start()
+            .ok_or_else(|| ZipError::Malformed(format!("no local header for {raw_name}")))?;
+        let end = start
+            .checked_add(file.compressed_size())
+            .filter(|&end| end <= bytes.len() as u64)
+            .ok_or_else(|| ZipError::Malformed(format!("data of {raw_name} runs past the end")))?;
+        if is_dir(
+            bytes,
+            file.central_header_start(),
+            &raw_name,
+            file.external_attributes(),
+        ) {
+            continue;
+        }
+        let entry = Entry {
+            name: raw_name.strip_prefix('/').unwrap_or(&raw_name).to_owned(),
+            declared: file.size(),
+            method,
+            // Both bounds are within `bytes`, so they fit in usize.
+            start: start as usize,
+            end: end as usize,
+        };
+        let scanned = Scanned { raw_name, entry };
+        match by_raw.get(&scanned.raw_name) {
+            Some(&i) => entries[i] = scanned,
+            None => {
+                by_raw.insert(scanned.raw_name.clone(), entries.len());
+                entries.push(scanned);
+            }
+        }
+    }
+    Ok(entries)
+}
+
+fn read_u16(bytes: &[u8], at: u64) -> Option<u16> {
+    let at = usize::try_from(at).ok()?;
+    let b = bytes.get(at..at.checked_add(2)?)?;
+    Some(u16::from_le_bytes([b[0], b[1]]))
+}
+
+/// The raw compression method of a central directory record (offset 10). The `zip` crate maps
+/// methods it was built without to an opaque value, so the field is read directly.
+fn compression_method(bytes: &[u8], central_header_start: u64) -> Option<u16> {
+    read_u16(bytes, central_header_start.checked_add(10)?)
+}
+
+/// JSZip's directory test: the DOS directory attribute, a trailing `/`, or (for entries made on
+/// Unix) the `0x4000` bit of the Unix mode.
+fn is_dir(bytes: &[u8], central_header_start: u64, name: &str, external: u32) -> bool {
+    if external & 0x10 != 0 || name.ends_with('/') {
+        return true;
+    }
+    let made_by_unix = central_header_start
+        .checked_add(4)
+        .and_then(|at| read_u16(bytes, at))
+        .is_some_and(|v| v >> 8 == 3);
+    made_by_unix && (external >> 16) & 0x4000 != 0
+}
